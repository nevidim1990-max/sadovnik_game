"{\n  \"engine_identity\": {\n    \"engine_id\": \"universal-platformer-core\",\n    \"version\": \"8.5.0\",\n    \"target_genre\": \"2D-plaftormer\",\n    \"target_runtime\": \"Phaser 3 stable (CDN)\",\n    \"deliverable_files\": [\"engine/index.html\", \"data/engine_spec.json\"],\n    \"factory_contract\": \"window.GAME_DATA (theme, lore, entities, progression, assets) + ENGINE_SPEC\"\n  },\n  \"runtime\": {\n    \"renderer\": \"Phaser.AUTO\",\n    \"physics\": \"Arcade\",\n    \"fixed_dt\": 0.0166666,\n    \"render_dt\": \"variable\",\n    \"scale_mode\": \"Phaser.Scale.FIT\",\n    \"loop_phases\": [\"INPUT\", \"UPDATE\", \"PHYSICS\", \"RENDER\", \"EVENT\"],\n    \"dependencies\": [\"phaser@3.80.1/dist/phaser.min.js\"]\n  },\n  \"factory_integration\": {\n    \"input\": \"genre only\",\n    \"output_stage_0_1\": [\"engine/index.html\", \"data/engine_spec.json\"],\n    \"final_package\": \"game_build_package.zip\",\n    \"data_source\": \"window.GAME_DATA OR data/*.json fetch\"\n  },\n  \"genre_analysis\": {\n    \"genre_family\": \"action\",\n    \"primary_genre\": \"2D-platformer\",\n    \"secondary_genres\": [\"precision-platformer\", \"run-and-gun-lite\", \"collect-a-thon\"],\n    \"subgenre\": \"micro-phase-precision-platformer\",\n    \"hybrid_structure\": \"phase-sequenced platformer with checkpointed micro-levels\",\n    \"player_role\": \"runner-jumper operator\",\n    \"player_fantasy\": \"traverse hostile geometric terrain, outrun hazards, chain acrobatic movement\",\n    \"primary_activity\": \"run, jump, dodge, collect, reach goal\",\n    \"primary_decisions\": [\"jump timing\", \"route choice\", \"risk-vs-reward pickup\", \"upgrade pick\"],\n    \"skill_model\": \"timing, spacing, route planning, hazard prediction, momentum control\",\n    \"risk_model\": \"fall/contact death, checkpoint loss, missed optional collectibles\",\n    \"reward_model\": \"score, currency, unlocks, upgrade picks, achievement progress\",\n    \"progression_model\": \"vertical (difficulty) + horizontal (upgrades) + meta (unlocks)\",\n    \"replayability_model\": \"micro-phases, choice pool, mutators, achievements, score chase\"\n  },\n  \"reference_inspiration\": {\n    \"references\": [\n      \"Modern Celeste-like precision movement pacing\",\n      \"Super Meat Boy-style micro-rooms\",\n      \"Hollow Knight-style layered parallax backgrounds\",\n      \"Geometry Dash-style phase density and rhythm\",\n      \"Ori-style juice feedback on every action\"\n    ],\n    \"retention_reasons\": [\n      \"immediate responsiveness\",\n      \"clear micro-goals\",\n      \"checkpointing that respects player time\",\n      \"upgrade choice tension\",\n      \"satisfying juice feedback\"\n    ],\n    \"session_target\": \"10-15 minutes per macro-level\"\n  },\n  \"player_fantasy\": {\n    \"who\": \"operator of a lightweight geometric runner\",\n    \"what\": \"chain jumps, dashes and safe landings across micro-phases\",\n    \"controls\": \"keyboard (A/D + Space + Shift) OR pointer/touch virtual buttons\",\n    \"decisions\": [\"jump vs dash\", \"safe vs risky pickup\", \"which upgrade\"],\n    \"optimizes\": \"completion time, collection %, achievement progress\",\n    \"risks\": \"trap timing, gap width, enemy contact\",\n    \"rewards\": \"coins, score, upgrade pick, achievement\",\n    \"long_term_goal\": \"clear all macro-levels, unlock all upgrades, full achievements\"\n  },\n  \"gameplay_loops\": {\n    \"primary_loop\": {\n      \"steps\": [\"INPUT\", \"ACTION\", \"SYSTEM_RESPONSE\", \"CONSEQUENCE\", \"FEEDBACK\", \"REWARD_COST\", \"NEW_DECISION\"],\n      \"example\": \"player presses jump -> character jumps -> gravity pulls -> lands or dies -> squash-stretch juice + sfx -> checkpoint or coin -> next hazard\"\n    },\n    \"secondary_loops\": [\n      \"collect coin -> spend in meta -> unlock upgrade\",\n      \"avoid enemy -> kill enemy via stomp -> score\",\n      \"activate checkpoint -> respawn there on death\"\n    ],\n    \"meta_loop\": \"SESSION -> coins + achievements -> unlock upgrades -> new micro-phase options -> NEW SESSION\",\n    \"endgame_loop\": \"all upgrades unlocked -> chase 100% collect + time-trial + mutators\"\n  },\n  \"core_architecture\": {\n    \"entity_component_model\": {\n      \"base_components\": [\"Transform\", \"Velocity\", \"Sprite\", \"Collider\", \"Health\", \"PlayerTag\", \"EnemyTag\", \"CoinTag\", \"TrapTag\", \"CheckpointTag\", \"GoalTag\", \"AIState\", \"FSM\", \"Animated\"],\n      \"gameplay_components\": [\"Gravity\", \"Jump\", \"Dash\", \"DamageOnTouch\", \"Collectible\", \"Stompable\"],\n      \"composition_rules\": \"entity = { id, components: Map }; behavior emerges from component sets; no inheritance; no 'type' field\"\n    },\n    \"system_order\": [\n      \"InputSystem\",\n      \"ModifierSystem\",\n      \"RuleSystem\",\n      \"AISystem\",\n      \"MovementSystem\",\n      \"GravitySystem\",\n      \"CollisionSystem\",\n      \"DeathSystem\",\n      \"CheckpointSystem\",\n      \"RenderSystem\",\n      \"JuiceSystem\"\n    ],\n    \"event_bus\": {\n      \"core_events\": [\n        \"SESSION_STARTED\", \"SESSION_ENDED\", \"GAMEPLAY_START\", \"GAMEPLAY_STOP\",\n        \"CORE_ACTION_PERFORMED\", \"PROGRESS_CHANGED\", \"REWARD_GRANTED\",\n        \"ACHIEVEMENT_UNLOCKED\", \"ENTITY_CREATED\", \"ENTITY_DESTROYED\",\n        \"STAGE_COMPLETED\", \"OBJECTIVE_COMPLETED\", \"ERROR_REPORTED\",\n        \"AD_REQUESTED\", \"AD_RESULT\",\n        \"PLATFORM_INITIALIZED\", \"PLATFORM_ERROR\",\n        \"PLAYER_DIED\", \"CHECKPOINT_REACHED\", \"COIN_COLLECTED\",\n        \"ENEMY_KILLED\", \"MICRO_PHASE_COMPLETED\", \"MICRO_PHASE_STARTED\"\n      ],\n      \"extension_events\": [\"CAMERA_SHAKE\", \"HITSTOP\", \"PARTICLE_BURST\"]\n    },\n    \"micro_animation_system\": {\n      \"supported_classes\": [\"anim-idle\", \"anim-hover\", \"anim-interact\", \"anim-destroy\", \"none\"],\n      \"implementation_rule\": \"Phaser 3 Tweens; driven by entities.json animation_class + interaction_class; no sprite sheets required\",\n      \"trigger_mechanism\": \"state change OR pointerover/pointerdown OR event\"\n    }\n  },\n  \"rule_engine\": {\n    \"condition_types\": [\"HasComponent\", \"HasTag\", \"ValueCompare\", \"DistanceCheck\", \"EventMatch\"],\n    \"effect_types\": [\"ModifyComponent\", \"EmitEvent\", \"SpawnEntity\", \"DestroyEntity\", \"ApplyModifier\"],\n    \"sample_rules\": [\n      {\n        \"id\": \"coin_pickup\",\n        \"condition\": [{\"type\": \"EventMatch\", \"event\": \"COIN_COLLECTED\"}],\n        \"effect\": [{\"type\": \"EmitEvent\", \"event\": \"REWARD_GRANTED\", \"payload\": {\"coin\": 1}}],\n        \"priority\": 10\n      },\n      {\n        \"id\": \"enemy_stomp\",\n        \"condition\": [{\"type\": \"EventMatch\", \"event\": \"ENEMY_KILLED\"}],\n        \"effect\": [{\"type\": \"EmitEvent\", \"event\": \"REWARD_GRANTED\", \"payload\": {\"score\": 50}}],\n        \"priority\": 10\n      }\n    ]\n  },\n  \"modifier_system\": {\n    \"formula\": \"(BASE + FLAT) * MULT_PRODUCT * CONDITIONAL\",\n    \"stacking_rules\": \"stackable_add for FLAT, multiply for MULT\",\n    \"priority_model\": \"source_priority ASC then insertion_order ASC\",\n    \"duration_model\": \"permanent | timed | until_event\",\n    \"modifier_types\": [\"FLAT\", \"MULT\", \"CONDITIONAL\"],\n    \"targets\": [\"player.speed\", \"player.jump_force\", \"player.dash_cooldown\", \"player.max_hp\", \"coin.multiplier\"]\n  },\n  \"ai_architecture\": {\n    \"model\": \"FSM\",\n    \"state_definitions\": [\"idle\", \"patrol\", \"alert\", \"chase\", \"attack\", \"return\", \"dead\"],\n    \"transition_conditions\": [\n      \"patrol -> chase: distance(player) < alert_radius\",\n      \"chase -> attack: distance(player) < attack_range\",\n      \"attack -> chase: cooldown_elapsed\",\n      \"any -> dead: health <= 0\"\n    ]\n  },\n  \"render_layers\": [\n    {\"id\": \"background_far\",  \"layer\": \"LAYER_BACKGROUND\", \"z\": -300, \"has_collision\": false, \"parallax\": true},\n    {\"id\": \"background_mid\",  \"layer\": \"LAYER_BACKGROUND\", \"z\": -200, \"has_collision\": false, \"parallax\": true},\n    {\"id\": \"background_near\", \"layer\": \"LAYER_BACKGROUND\", \"z\": -100, \"has_collision\": false, \"parallax\": true},\n    {\"id\": \"gameplay\",        \"layer\": \"LAYER_GAMEPLAY\",   \"z\": 0,    \"has_collision\": true,  \"parallax\": false},\n    {\"id\": \"foreground\",      \"layer\": \"LAYER_FOREGROUND\", \"z\": 100,  \"has_collision\": false, \"parallax\": false},\n    {\"id\": \"ui\",              \"layer\": \"LAYER_UI\",         \"z\": 1000, \"has_collision\": false, \"parallax\": false}\n  ],\n  \"progression_data_format\": {\n    \"description\": \"Формат уровня в progression.json\",\n    \"macro_level_structure\": {\n      \"required_fields\": [\"level_id\", \"name\", \"micro_phases\", \"density_metrics\", \"difficulty_curve\"],\n      \"density_metrics\": {\n        \"min_encounters\": 12,\n        \"min_collectibles\": 8,\n        \"min_hazards\": 6,\n        \"min_micro_phases\": 6,\n        \"target_minutes\": [10, 15]\n      }\n    },\n    \"micro_level_structure\": {\n      \"required_fields\": [\n        \"micro_level_id\", \"sequence_index\", \"phase\", \"objective\",\n        \"world_or_board\", \"spatial_extent\", \"entities_in_zone\", \"decorative_layout\"\n      ],\n      \"entities_in_zone_schema\": {\n        \"entity_id\": \"string (ref entities.json)\",\n        \"instance_count\": \"integer >= 1\",\n        \"entity_category\": \"gameplay\",\n        \"row\": \"integer\",\n        \"col\": \"integer\"\n      },\n      \"decorative_layout_schema\": {\n        \"entity_id\": \"string (ref entities.json)\",\n        \"instance_count\": \"integer >= 1\",\n        \"render_layer\": \"background_far | background_mid | background_near | foreground\",\n        \"z_index\": \"integer\",\n        \"has_collision\": \"false\",\n        \"parallax_factor\": \"number 0.0-1.0\",\n        \"row\": \"integer | null\",\n        \"col\": \"integer | null\"\n      },\n      \"layer_mapping_rules\": {\n        \"background_far\":  \"LAYER_BACKGROUND (z<0, parallax HIGH, ~0.15)\",\n        \"background_mid\":  \"LAYER_BACKGROUND (z<0, parallax MEDIUM, ~0.4)\",\n        \"background_near\": \"LAYER_BACKGROUND (z<0, parallax LOW, ~0.7)\",\n        \"foreground\":      \"LAYER_FOREGROUND (z>0, parallax none)\"\n      }\n    }\n  },\n  \"game_data_schema\": {\n    \"theme.json\": {\n      \"required\": [\"palette\", \"texts\", \"font\", \"audio\", \"save_key\"],\n      \"palette\": {\"bg\": \"hex\", \"fg\": \"hex\", \"accent\": \"hex\", \"danger\": \"hex\", \"reward\": \"hex\"}\n    },\n    \"lore.json\": {\n      \"required\": [\"world_summary\", \"tone\", \"factions_or_contexts\", \"key_concepts\"]\n    },\n    \"entities.json\": {\n      \"required\": [\"player_or_core_agent\", \"opposing_or_active_forces\", \"player_tools_or_actions\", \"environment_or_context_entities\"],\n      \"entity_schema\": {\n        \"entity_id\": \"string\",\n        \"components\": {\"type\": \"object\"},\n        \"tags\": [\"string\"],\n        \"animation_class\": \"anim-idle | anim-pulse | none\",\n        \"interaction_class\": \"anim-squash | anim-flash | none\",\n        \"visual\": {\"shape\": \"rect|circle|poly\", \"color_key\": \"accent|fg|danger|reward|bg\", \"size\": [w, h]}\n      }\n    },\n    \"progression.json\": {\n      \"required\": [\"stages_or_levels\", \"density_metrics\", \"choice_pool\", \"achievements\", \"tutorial\", \"meta_upgrades\", \"difficulty_overrides\"]\n    },\n    \"asset_spec.json\": {\n      \"required\": [\"images\", \"audio\", \"animations\", \"fonts\", \"effects\", \"placeholders\"]\n    }\n  },\n  \"systems\": [\n    {\"system_id\": \"InputSystem\",      \"purpose\": \"abstract input -> commands\",     \"category\": \"core\",      \"inputs\": [\"raw input\"], \"outputs\": [\"Command\"], \"events_emitted\": [\"CORE_ACTION_PERFORMED\"]},\n    {\"system_id\": \"MovementSystem\",   \"purpose\": \"apply velocity to transform\",     \"category\": \"physics\"},\n    {\"system_id\": \"GravitySystem\",    \"purpose\": \"apply gravity to velocity\",       \"category\": \"physics\"},\n    {\"system_id\": \"CollisionSystem\",  \"purpose\": \"resolve gameplay-layer collisions\",\"category\": \"physics\"},\n    {\"system_id\": \"AISystem\",         \"purpose\": \"drive FSM transitions\",            \"category\": \"ai\"},\n    {\"system_id\": \"RuleSystem\",       \"purpose\": \"evaluate data rules\",              \"category\": \"core\"},\n    {\"system_id\": \"ModifierSystem\",   \"purpose\": \"compute final values\",             \"category\": \"core\"},\n    {\"system_id\": \"CheckpointSystem\", \"purpose\": \"track + respawn on mid-stage CP\",  \"category\": \"gameplay\"},\n    {\"system_id\": \"DeathSystem\",      \"purpose\": \"kill player on hazard contact\",    \"category\": \"gameplay\"},\n    {\"system_id\": \"RenderSystem\",     \"purpose\": \"render layers with parallax\",      \"category\": \"render\"},\n    {\"system_id\": \"JuiceSystem\",      \"purpose\": \"particles/tweens/hitstop\",         \"category\": \"render\"}\n  ],\n  \"system_dependencies\": {\n    \"InputSystem\": [],\n    \"ModifierSystem\": [\"InputSystem\"],\n    \"RuleSystem\": [\"ModifierSystem\"],\n    \"AISystem\": [\"RuleSystem\"],\n    \"MovementSystem\": [\"AISystem\"],\n    \"GravitySystem\": [\"MovementSystem\"],\n    \"CollisionSystem\": [\"GravitySystem\"],\n    \"CheckpointSystem\": [\"CollisionSystem\"],\n    \"DeathSystem\": [\"CollisionSystem\"],\n    \"RenderSystem\": [\"DeathSystem\"],\n    \"JuiceSystem\": [\"RenderSystem\"]\n  },\n  \"system_interactions\": [\n    {\"source\": \"InputSystem\", \"target\": \"MovementSystem\", \"event\": \"CORE_ACTION_PERFORMED\", \"effect\": \"set velocity\"},\n    {\"source\": \"CollisionSystem\", \"target\": \"DeathSystem\", \"event\": \"PLAYER_DIED\", \"effect\": \"respawn\"},\n    {\"source\": \"CollisionSystem\", \"target\": \"RuleSystem\", \"event\": \"COIN_COLLECTED\", \"effect\": \"reward\"}\n  ],\n  \"state_model\": {\n    \"ENGINE_STATE\": [\"initialized\", \"running\", \"paused\", \"shutdown\"],\n    \"RUNTIME_STATE\": [\"systems\", \"entities\", \"eventBus\"],\n    \"SESSION_STATE\": [\"current_level\", \"current_micro_phase\", \"score\", \"coins\", \"time\"],\n    \"WORLD_STATE\": [\"spawned_entities\", \"decorations\"],\n    \"PLAYER_STATE\": [\"position\", \"velocity\", \"hp\", \"checkpoint\"],\n    \"PROGRESSION_STATE\": [\"unlocked_upgrades\", \"achievements\", \"meta_coins\"],\n    \"META_STATE\": [\"version\", \"migrations\"],\n    \"PERSISTENT_STATE\": [\"localStorage\"],\n    \"DERIVED_STATE\": [\"computed_final_values\"],\n    \"PRESENTATION_STATE\": [\"camera\", \"hud\", \"screen\"]\n  },\n  \"entity_model\": {\n    \"structure\": \"{ id: string, components: Map<name, POD> }\",\n    \"no_inheritance\": true,\n    \"runtime_composition\": true,\n    \"queries\": \"system declares required component set\"\n  },\n  \"component_model\": {\n    \"POD_only\": true,\n    \"no_methods\": true,\n    \"examples\": {\n      \"Transform\": {\"x\": 0, \"y\": 0},\n      \"Velocity\":  {\"vx\": 0, \"vy\": 0},\n      \"Sprite\":    {\"key\": \"shape\", \"w\": 32, \"h\": 32, \"color\": 0xffffff, \"layer\": \"gameplay\", \"z\": 0},\n      \"Collider\":  {\"w\": 32, \"h\": 32, \"static\": false},\n      \"Health\":    {\"hp\": 1, \"max\": 1},\n      \"PlayerTag\": {},\n      \"EnemyTag\":  {\"behavior\": \"patrol\", \"alert_radius\": 200, \"speed\": 80},\n      \"CoinTag\":   {\"value\": 1},\n      \"TrapTag\":   {\"kind\": \"spike\"},\n      \"CheckpointTag\": {\"index\": 0},\n      \"GoalTag\":   {},\n      \"FSM\":       {\"current\": \"patrol\", \"transitions\": []},\n      \"Animated\":  {\"animation_class\": \"anim-idle\", \"interaction_class\": \"anim-squash\"}\n    }\n  },\n  \"content_domains\": [\"entities\", \"progression\", \"theme\", \"lore\", \"assets\", \"rules\"],\n  \"rules\": {\n    \"description\": \"data-driven rules read from GAME_DATA.rules or embedded\",\n    \"runtime_evaluation\": \"per frame, priority ordered\"\n  },\n  \"conditions\": [\"HasComponent\", \"HasTag\", \"ValueCompare\", \"DistanceCheck\", \"EventMatch\"],\n  \"effects\": [\"ModifyComponent\", \"EmitEvent\", \"SpawnEntity\", \"DestroyEntity\", \"ApplyModifier\"],\n  \"modifiers\": {\n    \"types\": [\"FLAT\", \"MULT\", \"CONDITIONAL\"],\n    \"stacking\": \"FLAT adds, MULT multiplies, CONDITIONAL gate\"\n  },\n  \"events\": {\n    \"core\": [\n      \"SESSION_STARTED\", \"SESSION_ENDED\", \"GAMEPLAY_START\", \"GAMEPLAY_STOP\",\n      \"CORE_ACTION_PERFORMED\", \"PROGRESS_CHANGED\", \"REWARD_GRANTED\",\n      \"ACHIEVEMENT_UNLOCKED\", \"ENTITY_CREATED\", \"ENTITY_DESTROYED\",\n      \"STAGE_COMPLETED\", \"OBJECTIVE_COMPLETED\", \"ERROR_REPORTED\",\n      \"AD_REQUESTED\", \"AD_RESULT\", \"PLAYER_DIED\", \"CHECKPOINT_REACHED\",\n      \"COIN_COLLECTED\", \"ENEMY_KILLED\", \"MICRO_PHASE_STARTED\", \"MICRO_PHASE_COMPLETED\"\n    ]\n  },\n  \"progression\": {\n    \"curves\": [\"linear\", \"exponential\", \"logistic\", \"stepped\", \"polynomial\", \"soft-cap\", \"hard-cap\", \"diminishing-return\"],\n    \"macro_levels\": \"each with micro_phases[]\",\n    \"mid_stage_checkpointing\": true,\n    \"upgrade_choice_after\": \"every 2 micro_phases or on level completion\"\n  },\n  \"economy\": {\n    \"sources\": [\"coin pickup\", \"enemy kill reward\", \"level completion bonus\"],\n    \"sinks\": [\"meta_upgrade purchase\"],\n    \"currency\": [\"coins\"],\n    \"scaling\": \"linear with soft-cap\"\n  },\n  \"rewards\": {\n    \"types\": [\"currency\", \"unlock\", \"score\", \"ability\", \"content\", \"achievement\"]\n  },\n  \"objectives\": {\n    \"types\": [\"reach_goal\", \"collect_n\", \"survive_time\", \"kill_n\"]\n  },\n  \"achievements\": {\n    \"count_min\": 5,\n    \"checked_via\": \"EventBus subscriptions\"\n  },\n  \"AI\": {\n    \"model\": \"FSM\",\n    \"states\": [\"idle\", \"patrol\", \"alert\", \"chase\", \"attack\", \"return\", \"dead\"]\n  },\n  \"simulation\": {\"applies\": false, \"genre_equivalent\": \"hazard/enemy state machine\"},\n  \"procedural_generation\": {\n    \"supported\": true,\n    \"seed\": \"level_id hash\",\n    \"usage\": \"optional decoration scatter if data requests\"\n  },\n  \"difficulty\": {\n    \"dimensions\": [\"hazard density\", \"gap width\", \"enemy speed\", \"time pressure\", \"checkpoint spacing\"]\n  },\n  \"replayability\": {\n    \"mechanisms\": [\"upgrade choice pool\", \"achievements\", \"collect %\", \"time-trial\", \"mutators\"]\n  },\n  \"endgame\": {\n    \"mechanisms\": [\"100% collection\", \"time-trial\", \"mutator runs\", \"all upgrades\"]\n  },\n  \"UI\": {\n    \"screens\": [\"LoadingScene\", \"PreloadScene\", \"MenuScene\", \"GameScene\", \"HUDScene\", \"PauseScene\", \"ResultScene\", \"UpgradeScene\", \"SettingsScene\", \"AchievementsScene\"],\n    \"model\": \"GameState -> Presentation -> UI\"\n  },\n  \"screens\": {\n    \"required_categories\": [\n      \"loading\", \"asset_preload\", \"main_menu\", \"gameplay_hud\",\n      \"pause\", \"session_result\", \"genre_specific (upgrade_choice)\"\n    ]\n  },\n  \"onboarding\": {\n    \"read_from\": \"GAME_DATA.progression.tutorial\",\n    \"steps_min\": 3,\n    \"no_hardcoded_text\": true\n  },\n  \"settings\": {\n    \"fields\": [\"music_volume\", \"sfx_volume\", \"music_on\", \"sfx_on\", \"effects_quality\", \"language\"],\n    \"persisted\": true\n  },\n  \"input\": {\n    \"keyboard\": {\"left\": \"A/LEFT\", \"right\": \"D/RIGHT\", \"jump\": \"SPACE/UP\", \"dash\": \"SHIFT\", \"pause\": \"ESC\"},\n    \"touch\": \"virtual buttons\",\n    \"abstract_commands\": [\"MOVE_LEFT\", \"MOVE_RIGHT\", \"JUMP\", \"DASH\", \"PAUSE\"]\n  },\n  \"rendering\": {\n    \"layers\": [\"LAYER_BACKGROUND\", \"LAYER_GAMEPLAY\", \"LAYER_FOREGROUND\", \"LAYER_UI\"],\n    \"collisions_only_in\": [\"LAYER_GAMEPLAY\"],\n    \"parallax_supported\": true,\n    \"decorative_layout_supported\": true\n  },\n  \"audio\": {\n    \"channels\": [\"master\", \"music\", \"sfx\"],\n    \"adaptive_music_states\": [\"calm\", \"intense\"],\n    \"pitch_jitter\": \"±5-10%\",\n    \"sfx_variants_per_event\": 2\n  },\n  \"assets\": {\n    \"types\": [\"images\", \"audio\", \"animations\", \"fonts\", \"effects\", \"placeholders\"],\n    \"fallback\": \"procedural placeholders generated in-engine\"\n  },\n  \"localization\": {\n    \"keys\": \"all user-facing strings via theme.texts.*\",\n    \"fallback_lang\": \"en\"\n  },\n  \"save\": {\n    \"storage\": \"localStorage\",\n    \"version_field\": \"save.version\",\n    \"migration\": true,\n    \"mid_stage_checkpointing\": true,\n    \"corruption_handling\": \"reset with diagnostic\"\n  },\n  \"offline_progress\": {\"applies\": false},\n  \"performance\": {\n    \"object_pooling\": [\"particles\", \"sfx players\"],\n    \"no_hot_allocations\": true,\n    \"rendering\": \"canvas\"\n  },\n  \"platform_adapter\": {\n    \"methods\": [\"gameplayStart\", \"gameplayStop\", \"rewardAd\", \"interstitialAd\", \"submitScore\", \"isAdAvailable\"],\n    \"events\": [\"AD_REQUESTED\", \"AD_RESULT\", \"PLATFORM_INITIALIZED\", \"PLATFORM_ERROR\"],\n    \"fallback\": \"no-op adapter\"\n  },\n  \"validation\": {\n    \"schema_validation\": true,\n    \"reference_validation\": true,\n    \"safe_defaults\": true,\n    \"debug_mode\": \"?debug=1\"\n  },\n  \"testing\": {\n    \"harness\": \"internal boot with synthetic GAME_DATA\",\n    \"modes\": [\"minimal\", \"empty\", \"corrupted\"]\n  },\n  \"accessibility\": {\n    \"minimal\": [\"readable HUD scale\", \"no reliance on color only\", \"pause anytime\"]\n  },\n  \"visual_coherence_protocol\": {\n    \"strict_palette_locking\": true,\n    \"grid_snapping\": 32,\n    \"strict_layer_separation\": true,\n    \"zero_logic_decorations\": true\n  }\n}"